# Nexa — Environment Variables Example
# Copy this file to .env.local and populate values for local development.
# DO NOT COMMIT REAL SECRETS TO THE REPOSITORY.

# AI Provider API Keys (Server-side only, NEVER use NEXT_PUBLIC_ prefix)
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Authentication & Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
